# Variables exclusivas del servidor. No uses el prefijo NEXT_PUBLIC_ para claves.
# Copia este archivo como .env.local y añade la credencial fuera de Git.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
ATLAS_DEFAULT_TIMEZONE=America/Bogota
ATLAS_INDIVIDUAL_REQUEST_BUDGET=45
ATLAS_JOURNEY_REQUEST_BUDGET=90
ATLAS_PROFILE_REQUEST_BUDGET=30
ATLAS_REANALYSIS_REQUEST_BUDGET=60
ATLAS_PROVIDER_CONCURRENCY=3
ATLAS_QUOTA_WARNING_PERCENT=15
ATLAS_QUOTA_BLOCK_PERCENT=5

# Acceso personal. Genera estos valores con: npm run auth:configure -- tu_usuario
# Nunca uses una contraseña en texto plano ni el prefijo NEXT_PUBLIC_ aquí.
ATLAS_PERSONAL_USERNAME=
ATLAS_PERSONAL_PASSWORD_HASH=
ATLAS_SESSION_SECRET=
ATLAS_SESSION_TTL_SECONDS=604800

# Persistencia operativa local. No requiere base de datos externa.
# Atlas no usa ninguna clave de Gemini: el flujo es manual por copiar y pegar.
