import { assessParlayRisk } from "./parlayAssessmentEngine.js";

export function buildDirectorParlayAssessment(parlayCandidate = {}) {

  const assessment = assessParlayRisk(parlayCandidate);


  return {
    type: "parlay_assessment",

    risk_level:
      assessment.risk_level ??
      assessment.risk ??
      "unknown",

    supported_selections:
      assessment.supported_selections ??
      assessment.supported_count ??
      0,

    unsupported_selections:
      assessment.unsupported_selections ??
      assessment.unsupported_count ??
      0,

    correlation_flags:
      assessment.correlation_flags ??
      assessment.flags ??
      [],

    director_message:
      buildDirectorMessage(assessment),

    technical:
      assessment,
  };
}


function buildDirectorMessage(assessment) {

  const risk =
    assessment.risk_level ??
    assessment.risk ??
    "unknown";


  if (risk === "high") {

    return (
      "Riesgo alto. " +
      "Existen selecciones con soporte analítico, " +
      "pero la combinación aumenta la incertidumbre acumulada."
    );

  }


  if (risk === "medium") {

    return (
      "Riesgo moderado. " +
      "La combinación presenta soporte, " +
      "aunque existen factores que reducen su solidez."
    );

  }


  return (
    "La combinación fue evaluada según el soporte disponible."
  );
}
